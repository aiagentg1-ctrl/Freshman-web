# Neon PostgreSQL Connection
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/quillprep?sslmode=require

# Telegram Bot Token (for HMAC validation)
NEXT_PUBLIC_BOT_TOKEN=your_bot_token_here

# Admin Telegram ID
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Frontend URL (or localhost for dev)
NEXT_PUBLIC_APP_URL=https://your-vercel-app.vercel.app

# Currently deployed Python FastAPI backend URL.
# Change this when the Render Fresho service hostname is live.
BACKEND_URL=https://freshman-web.onrender.com
BROWSER_DEMO_MODE=true
BROWSER_DEMO_USER_ID=900000001

# Admin Secret for API authentication
ADMIN_SECRET=your_admin_secret_here

# --- Bot (bot.py) ---
# Telegram Bot Token & admin user id
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_id_here

# Mini App + Admin dashboard URLs
MINI_APP_URL=https://your-vercel-app.vercel.app/tma
ADMIN_URL=https://your-vercel-app.vercel.app/admin

# Required channel gate — users must join AAU101 before /start unlocks the app.
# The bot must be an admin in AAU101 to verify membership.
CHANNEL_1_ID=-1002656898914
CHANNEL_1_URL=https://t.me/AAU101
CHANNEL_1_NAME=AAU101

# Premium channel membership checks — set these to the actual Telegram channel IDs.
# The bot must be an administrator in both channels to verify members.
NATURAL_SCIENCE_CHANNEL_ID=-1004479037964
SOCIAL_SCIENCE_CHANNEL_ID=-1004342138729
