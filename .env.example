# Neon PostgreSQL Connection
DATABASE_URL=postgresql://user:password@ep-xxx.region.neon.tech/quillprep?sslmode=require

# Telegram Bot Token (for HMAC validation)
BOT_TOKEN=your_bot_token_here

# Admin Telegram ID
ADMIN_ID=your_telegram_id_here

# Admin Secret for API authentication
ADMIN_SECRET=your_admin_secret_here

# Mini App + Admin dashboard URLs
MINI_APP_URL=https://your-vercel-app.vercel.app/tma
ADMIN_URL=https://your-vercel-app.vercel.app/admin

# Webhook URL (optional - set if using webhook mode instead of polling)
WEBHOOK_URL=
BOT_MODE=polling

# Premium member channels used for automatic premium access checks.
# The bot must be an admin in both channels to verify membership.
PREMIUM_CHANNEL_NATURAL_ID=-1004479037964
PREMIUM_CHANNEL_SOCIAL_ID=-1004342138729

# Set to "true" to disable premium membership checks (for testing).
# Set to "false" to enforce channel membership for premium content.
PREMIUM_ACCESS_FREE=false

# Browser demo mode (for development/testing)
BROWSER_DEMO_MODE=false
BROWSER_DEMO_USER_ID=900000001
